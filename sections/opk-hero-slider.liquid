        "presets": [
            {
                "name": "Hero slider",
                "category": "Custom",
                "blocks": [
                    {"type": "slide"},
                    {"type": "slide"}
                ]
            }
        ],
        "disabled_on": {
            "groups": ["footer", "header", "aside"]
        }
    }
    {% endschema %}