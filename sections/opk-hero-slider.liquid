                    {
                        "type": "header",
                        "content": "Layout"
                    },
                    {
                        "type": "number",
                        "id": "width_content",
                        "label": "Width content",                        
                        "default": 500
                    },
                    {
                        "type": "header",
                        "content": "Colors"
                    },
                    {
                        "type": "color",
                        "id": "bg_color",
                        "label": "Background color",
                        "default": "#F5EFE2"
                    },                                      
                    {
                        "type": "color",
                        "id": "text_color",
                        "label": "Text color",
                        "default": "#1D1D1B"
                    },
                    {
                        "type": "color",
                        "id": "color_button_text",
                        "label": "t:sections.global.settings.color_button_text.label",
                        "default": "#171717"
                    },
                    {
                        "type": "color",
                        "id": "color_button_background",
                        "label": "t:sections.global.settings.color_button_background.label",
                        "default": "#ffffff"
                    },
                    {
                        "type": "color_background",
                        "id": "color_button_gradient",
                        "label": "t:sections.global.settings.color_button_gradient.label"
                    },
                    {
                        "type": "color",
                        "id": "color_overlay",
                        "label": "t:sections.global.settings.color_overlay.label",
